--- a/arch/arm/boot/dts/overlays/Makefile
+++ b/arch/arm/boot/dts/overlays/Makefile
@@ -364,5 +364,7 @@ dtbo-$(CONFIG_ARCH_BCM2835) += \
 targets += dtbs dtbs_install
 targets += $(dtbo-y)
 
+subdir-y	:= iotg-rpi5
+
 always-y	:= $(dtbo-y)
