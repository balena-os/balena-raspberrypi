 arch/arm/boot/dts/overlays/iotg-rpi5/Makefile |  13 ++
 arch/arm/boot/dts/overlays/iotg-rpi5/README   |  44 +++++++
 .../iotg-rpi5/iotg-rpi5-b2b-overlay.dts       |  21 ++++
 .../iotg-rpi5/iotg-rpi5-gmc-overlay.dts       | 111 ++++++++++++++++++
 .../iotg-rpi5/iotg-rpi5-io-a-overlay.dts      |  64 ++++++++++
 .../iotg-rpi5/iotg-rpi5-io-b-overlay.dts      |  64 ++++++++++
 7 files changed, 319 insertions(+)
 create mode 100644 arch/arm/boot/dts/overlays/iotg-rpi5/Makefile
 create mode 100644 arch/arm/boot/dts/overlays/iotg-rpi5/README
 create mode 100644 arch/arm/boot/dts/overlays/iotg-rpi5/iotg-rpi5-b2b-overlay.dts
 create mode 100644 arch/arm/boot/dts/overlays/iotg-rpi5/iotg-rpi5-gmc-overlay.dts
 create mode 100644 arch/arm/boot/dts/overlays/iotg-rpi5/iotg-rpi5-io-a-overlay.dts
