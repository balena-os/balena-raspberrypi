[Unit]
Description=Watch for DKMS module sources
After=balena-dkms.service
Requires=balena-dkms.service

[Path]
# balena-dkms.service creates this directory on its first (boot-time) run,
# so it exists by the time this unit starts watching it.
#
# DirectoryNotEmpty, not PathChanged/PathModified: per systemd.path(5),
# both of those watch the target path itself as a *file* being written to
# (PathChanged on close-after-write, PathModified on any write) -- neither
# reacts to a directory gaining/losing entries. DirectoryNotEmpty is the
# actual "watch a drop folder" directive. Confirmed on-device: a real
# `cp -R` of a new module dir did not retrigger the service under
# PathModified, consistent with it never being the right directive for
# this in the first place.
DirectoryNotEmpty=/mnt/data/dkms-src
Unit=balena-dkms.service

[Install]
WantedBy=multi-user.target
