#!/bin/bash

set -u

SRC_ROOT="/mnt/data/dkms-src"
DKMS_TREE="/mnt/data/dkms/dkms_tree"
KVER="$(uname -r)"
KERNEL_SRC_DIR="/usr/src/${KVER}/build"

CROSS_COMPILE=""
if ! command -v gcc >/dev/null 2>&1; then
    gcc_bin=$(find /usr/bin -maxdepth 1 -name '*-gcc' 2>/dev/null | head -n1)
    if [ -n "$gcc_bin" ]; then
        CROSS_COMPILE="$(basename "$gcc_bin")"
        CROSS_COMPILE="${CROSS_COMPILE%gcc}"
    fi
fi
export CROSS_COMPILE
case "$(uname -m)" in
    aarch64) export ARCH=arm64 ;;
    armv7l|armv6l) export ARCH=arm ;;
    x86_64) export ARCH=x86_64 ;;
esac

mkdir -p "$SRC_ROOT" "$DKMS_TREE"

status_write() {
    statusdir="$1"; modname="$2"; state="$3"; message="$4"
    mkdir -p "$statusdir"
    cat > "$statusdir/status.json" <<EOF
{
  "module": "$modname",
  "kernel_abi": "$KVER",
  "state": "$state",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
    [ -n "$message" ] && echo "$message" >> "$statusdir/build.log"
}

for src in "$SRC_ROOT"/*/; do
    [ -d "$src" ] || continue
    moddir="${src%/}"
    conf="$moddir/dkms.conf"
    [ -f "$conf" ] || continue

    # dkms.conf is a shell-sourceable key=value file -- dkms' own convention.
    PACKAGE_NAME=""
    PACKAGE_VERSION=""
    # shellcheck disable=SC1090
    . "$conf"
    if [ -z "$PACKAGE_NAME" ] || [ -z "$PACKAGE_VERSION" ]; then
        echo "balena-dkms: $moddir: dkms.conf missing PACKAGE_NAME/PACKAGE_VERSION, skipping" >&2
        continue
    fi
    modname="$PACKAGE_NAME"
    modver="$PACKAGE_VERSION"
    statusdir="$DKMS_TREE/$modname/$modver/$KVER/.status"

    hash=$(find "$moddir" -type f -print | sort | xargs sha256sum | sha256sum)
    hash="${hash%% *}"
    cachefile="$statusdir/built.hash"
    kohashfile="$statusdir/built.ko.hash"

    kofile=$(find "$DKMS_TREE/$modname/$modver/$KVER" \
        \( -name '*.ko' -o -name '*.ko.zst' -o -name '*.ko.gz' -o -name '*.ko.xz' \) \
        2>/dev/null | head -n1)

    cache_hit=false

    # if the sources didn't changed and neither did the module.
    # this cache mechanism doesn't verify the kernel ABI
    # the module was built against
    if [ -f "$cachefile" ] && [ "$(cat "$cachefile")" = "$hash" ] \
        && [ -n "$kofile" ] && [ -f "$kohashfile" ] \
        && [ "$(cat "$kohashfile")" = "$(sha256sum "$kofile" | cut -d' ' -f1)" ]; then
        cache_hit=true
    fi

    if [ "$cache_hit" = true ]; then
        :
    else
        status_write "$statusdir" "$modname" "building" "building $modname-$modver against $KVER"

        dkms add -m "$modname" -v "$modver" --dkmstree "$DKMS_TREE" --sourcetree "$SRC_ROOT" \
            >>"$statusdir/build.log" 2>&1

        if dkms build -m "$modname" -v "$modver" -k "$KVER" \
            --dkmstree "$DKMS_TREE" --sourcetree "$SRC_ROOT" --kernelsourcedir "$KERNEL_SRC_DIR" \
            >>"$statusdir/build.log" 2>&1
        then
            kofile=$(find "$DKMS_TREE/$modname/$modver/$KVER" \
                \( -name '*.ko' -o -name '*.ko.zst' -o -name '*.ko.gz' -o -name '*.ko.xz' \) \
                2>/dev/null | head -n1)
            if [ -z "$kofile" ]; then
                status_write "$statusdir" "$modname" "failed" "build reported success but no .ko found under $DKMS_TREE/$modname/$modver/$KVER"
                continue
            fi
            echo "$hash" > "$cachefile"
            sha256sum "$kofile" | cut -d' ' -f1 > "$kohashfile"
            status_write "$statusdir" "$modname" "built" "built $kofile"
        else
            status_write "$statusdir" "$modname" "failed" "dkms build failed, see build.log"
            continue
        fi
    fi

    modtag="${modname//-/_}"
    if lsmod | grep -q "^${modtag} "; then
        status_write "$statusdir" "$modname" "loaded" "$modname already loaded"
        continue
    fi

    # untested
    depends=$(modinfo -F depends "$kofile" 2>/dev/null | tr ',' ' ')
    for dep in $depends; do
        [ -n "$dep" ] || continue
        modprobe "$dep" >>"$statusdir/build.log" 2>&1
    done

    # we won't be able to load modules that have dependencies on our own dkms modules
    # as we don't update depmod
    if insmod "$kofile" >>"$statusdir/build.log" 2>&1; then
        status_write "$statusdir" "$modname" "loaded" "loaded $kofile"
    else
        status_write "$statusdir" "$modname" "reboot-required" "insmod failed for $kofile, see build.log"
    fi
done
